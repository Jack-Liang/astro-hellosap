---
import { getCollection, render } from 'astro:content'
import readingTime from 'reading-time'
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';
import Notation from '../../components/Notation.astro';
import GiscusComments from '../../components/GiscusComments.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts')
  return posts.map(p => ({
    params: { slug: p.data.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props
const { title, slug, description, publishDate, tags } = post.data;
const readingTimeEstimate = readingTime(post.body).text
const permalink = new URL(`blog/${slug}`, Astro.site).href;
const { Content } = await render(post)
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <header>
    <p>{publishDate} ~ {readingTimeEstimate}</p>
    <h1>{title}</h1>
    {tags && tags.length > 0 && (
      <div class="tags-wrapper">
        <div class="tags-inner" id="post-tags">
          {tags.map(tag => (
            <span class="post-tag">{tag}</span>
          ))}
        </div>
        <button class="tags-toggle" id="tags-toggle" style="display: none;"><span class="toggle-text">展开</span><span class="toggle-arrow">▼</span></button>
      </div>
    )}
    <hr />
  </header>
  <div class="container">
    <article class="content">
      <Content components={{ Notation: Notation }} />
    </article>
    <hr />
    <Bio />
    <GiscusComments title={title} />
  </div>
</BaseLayout>

<style>
  header {
    text-align: center;
  }

  header h1 {
    margin-bottom: 0.7em;
  }

  header p {
    color: var(--text-secondary);
    text-transform: uppercase;
    font-family: var(--font-family-sans);
    font-weight: 600;
  }

  header hr {
    min-width: 100px;
    width: 30%;
  }

  .post-tags {
    margin: 20px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .post-tag {
    padding: 5px 14px;
    background: var(--tag-bg);
    border-radius: 15px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 20px 0;
  }

  .tags-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .tags-inner.collapsed {
    max-height: 60px;
    overflow: hidden;
  }

  .tags-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: none;
    background: var(--text-secondary);
    color: white;
    border-radius: 16px;
    cursor: pointer;
    font-size: 12px;
    transition: all 0.2s ease;
  }

  .tags-toggle:hover {
    background: var(--primary-color);
  }

  .tags-toggle .toggle-text {
    pointer-events: none;
  }

  .tags-toggle .toggle-arrow {
    pointer-events: none;
    font-size: 10px;
  }
</style>

<script>
  import { createTagsToggle } from '../../scripts/tags-toggle.js'

  const initTagsToggle = () =>
    createTagsToggle('post-tags', 'tags-toggle', {
      lineHeight: 40,
      maxLines: 2,
      expandedDisplay: 'inline-flex'
    })

  initTagsToggle()
  document.addEventListener('astro:page-load', initTagsToggle)
</script>

<script>
  // 代码块增强：语言标签 + 复制按钮
  function initCodeBlocks() {
    const pres = document.querySelectorAll('article.content pre');
    pres.forEach((pre) => {
      if (pre.querySelector('.code-copy-btn')) return; // 避免重复注入

      // 语言标签（取 data-language，plaintext 不显示）
      const lang = pre.getAttribute('data-language');
      if (lang && lang !== 'plaintext' && lang !== 'text') {
        const label = document.createElement('span');
        label.className = 'code-lang-label';
        label.textContent = lang;
        pre.append(label);
      }

      // 复制按钮
      const btn = document.createElement('button');
      btn.className = 'code-copy-btn';
      btn.setAttribute('aria-label', '复制代码');
      btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
      btn.addEventListener('click', async () => {
        const code = pre.querySelector('code');
        const text = code ? code.innerText : '';
        try {
          await navigator.clipboard.writeText(text);
          btn.classList.add('copied');
          btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
          setTimeout(() => {
            btn.classList.remove('copied');
            btn.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
          }, 2000);
        } catch (e) {
          // 剪贴板 API 不可用（如非 HTTPS），静默失败
        }
      });
      pre.append(btn);
    });
  }

  initCodeBlocks();
  document.addEventListener('astro:page-load', initCodeBlocks);
</script>

<script>
  import { annotate, annotationGroup } from "rough-notation";

  function initNotation() {
    // ClientRouter 首次加载也会派发 astro:page-load，与模块直执行叠加会跑两遍，
    // 用标记防止同一元素被重复 annotate（会插入两份 SVG、注册两套观察器）
    const notations = document.querySelectorAll("[data-notation]:not([data-notation-ready])");
    if (notations.length === 0) return;
    notations.forEach((n) => n.setAttribute("data-notation-ready", ""));

    const els = Array.from(notations) as HTMLElement[];
    const annotations = els.map((el) => {
      const type = el.dataset.notationType as "underline" | "circle" | "crossed-off" | "highlight" | "strike-through" | "bracket";
      const color = el.dataset.notationColor;
      const strokeWidth = el.dataset.notationStrokeWidth;
      const animationDuration = el.dataset.notationAnimationDuration;

      return annotate(el, {
        type: type || "underline",
        color: color || "red",
        animate: true,
        animationDuration: animationDuration ? Number(animationDuration) : 800,
        multiline: type === "bracket" ? false : true,
        brackets: ["left", "right"],
        strokeWidth: strokeWidth ? Number(strokeWidth) : 1.5,
      });
    });

    const group = annotationGroup(annotations);

    // rough-annotation 的 SVG 按绘制时刻的坐标绝对定位，库本身只监听 window.resize
    // 和被注元素自身尺寸变化；图片晚加载、字体替换、<details> 展开等引发的整段
    // 位移它感知不到，SVG 会留在原地错位。这里观察内容区的布局变化，任何变化
    // 后把已显示的注释全部立即重绘（showing 状态下 show() 走 animate:false 的
    // 无动画重绘路径，开销可忽略）。
    const redrawAll = () => {
      annotations.forEach((a) => a.isShowing() && a.show());
    };
    if ("ResizeObserver" in window) {
      const ro = new ResizeObserver(redrawAll);
      const article = document.querySelector("article.content");
      if (article) ro.observe(article);
      document
        .querySelectorAll("article.content img, article.content details, .tags-inner")
        .forEach((el) => ro.observe(el));
    }

    // 任意注释元素进入视口时播放动画（只触发一次；观察全部元素，
    // 避免锚点跳转/快速滚动跳过第一个元素后动画永不触发）
    let shown = false;
    const observer = new IntersectionObserver((entries) => {
      if (shown) return;
      if (entries.some((entry) => entry.isIntersecting)) {
        shown = true;
        observer.disconnect();
        group.show();
      }
    }, { threshold: 0.1 });
    els.forEach((el) => observer.observe(el));
  }

  initNotation();
  document.addEventListener('astro:page-load', initNotation);
</script>
