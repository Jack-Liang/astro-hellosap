---
import { getCollection, render } from 'astro:content'
import readingTime from 'reading-time'
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bio from '../../components/Bio.astro';
import Notation from '../../components/Notation.astro';

export async function getStaticPaths() {
	const posts = await getCollection('posts')
  return posts.map(p => ({
    params: { slug: p.data.slug },
    props: { post: p },
  }));
}

const { post } = Astro.props
const { title, slug, description, publishDate, tags } = post.data;
const readingTimeEstimate = readingTime(post.body).text
const permalink = new URL(`blog/${slug}`, Astro.site).href;
const { Content } = await render(post)
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <header>
    <p>{publishDate} ~ {readingTimeEstimate}</p>
    <h1>{title}</h1>
    {tags && tags.length > 0 && (
      <div class="tags-wrapper">
        <div class="tags-inner" id="post-tags">
          {tags.map(tag => (
            <span class="post-tag">{tag}</span>
          ))}
        </div>
        <button class="tags-toggle" id="tags-toggle" style="display: none;"><span class="toggle-text">展开</span><span class="toggle-arrow">▼</span></button>
      </div>
    )}
    <hr />
  </header>
  <div class="container">
    <article class="content">
      <Content components={{ Notation: Notation }} />
    </article>
    <hr />
    <Bio />
  </div>
</BaseLayout>

<style>
  header {
    text-align: center;
  }

  header h1 {
    margin-bottom: 0.7em;
  }

  header p {
    color: var(--text-secondary);
    text-transform: uppercase;
    font-family: var(--font-family-sans);
    font-weight: 600;
  }

  header hr {
    min-width: 100px;
    width: 30%;
  }

  .post-tags {
    margin: 20px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .post-tag {
    padding: 5px 14px;
    background: var(--tag-bg);
    border-radius: 15px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin: 20px 0;
  }

  .tags-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  .tags-inner.collapsed {
    max-height: 60px;
    overflow: hidden;
  }

  .tags-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: none;
    background: var(--text-secondary);
    color: white;
    border-radius: 16px;
    cursor: pointer;
    font-size: 12px;
    transition: all 0.2s ease;
  }

  .tags-toggle:hover {
    background: var(--primary-color);
  }

  .tags-toggle .toggle-text {
    pointer-events: none;
  }

  .tags-toggle .toggle-arrow {
    pointer-events: none;
    font-size: 10px;
  }
</style>

<script>
  import { createTagsToggle } from '../../scripts/tags-toggle.js'

  const initTagsToggle = () =>
    createTagsToggle('post-tags', 'tags-toggle', {
      lineHeight: 40,
      maxLines: 2,
      expandedDisplay: 'inline-flex'
    })

  initTagsToggle()
  document.addEventListener('astro:page-load', initTagsToggle)
</script>

<script>
  import { annotate, annotationGroup } from "rough-notation";

  function initNotation() {
    const notations = document.querySelectorAll("[data-notation]");
    if (notations.length === 0) return;

    const annotations = Array.from(notations).map((node) => {
      const el = node as HTMLElement;
      const type = el.dataset.notationType as "underline" | "circle" | "crossed-off" | "highlight" | "strike-through" | "bracket";
      const color = el.dataset.notationColor;
      const strokeWidth = el.dataset.notationStrokeWidth;
      const animationDuration = el.dataset.notationAnimationDuration;

      return annotate(el, {
        type: type || "underline",
        color: color || "red",
        animate: true,
        animationDuration: animationDuration ? Number(animationDuration) : 800,
        multiline: type === "bracket" ? false : true,
        brackets: ["left", "right"],
        strokeWidth: strokeWidth ? Number(strokeWidth) : 1.5,
      });
    });

    const group = annotationGroup(annotations);

    // 使用 IntersectionObserver 检测第一个元素进入视口时播放动画
    const firstEl = notations[0] as HTMLElement;
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          group.show();
          observer.disconnect();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(firstEl);
  }

  initNotation();
  document.addEventListener('astro:page-load', initNotation);
</script>
