---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = '文章列表';
const description = 'Latest articles.';
const permalink = new URL('blog', Astro.site).href;

let allPosts = await getCollection('posts')
allPosts = allPosts.filter(post => !post.data.hidden)
allPosts = allPosts.sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf());

const allTags = [...new Set(allPosts.flatMap(post => post.data.tags || []))].sort();
---

<BaseLayout title={title} description={description} permalink={permalink} current="blog">
  <div class="container">
    <h1>文章列表</h1>
    
    <div class="tags-filter">
      <span class="filter-label">标签筛选：</span>
      <div class="tags-wrapper">
        <div class="tags-inner" id="filter-tags">
          <button class="tag-btn active" data-tag="">全部</button>
          {allTags.map(tag => (
            <button class="tag-btn" data-tag={tag}>{tag}</button>
          ))}
        </div>
        <button class="tags-toggle" id="filter-tags-toggle" style="display: none;"><span class="toggle-text">展开</span><span class="toggle-arrow">▼</span></button>
      </div>
    </div>

    <div id="posts-container" class="posts-grid">
      {allPosts.map((post) => {
        const href = `/blog/${post.data.slug}`;
        return (
          <article class="post-card post-item-wrapper reveal" data-tags={JSON.stringify(post.data.tags || [])}>
            <a class="post-card-link" href={href}>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="post-tags">
                  {post.data.tags.map(tag => (
                    <span class="post-tag">{tag}</span>
                  ))}
                </div>
              )}
              <div class="post-item-footer">
                <span class="post-item-date">— {post.data.publishDate}</span>
              </div>
            </a>
          </article>
        )
      })}
    </div>
  </div>
</BaseLayout>

<script>
  import { createTagsToggle } from '../../scripts/tags-toggle.js'

  function initTagFilter() {
    const tagBtns = document.querySelectorAll('.tag-btn');
    const postWrappers = document.querySelectorAll('.post-item-wrapper');

    if (!tagBtns.length) return;

    // 标签栏折叠（与文章详情页共用逻辑）
    createTagsToggle('filter-tags', 'filter-tags-toggle', {
      lineHeight: 38,
      maxLines: 2,
      expandedDisplay: 'flex'
    });

    // 标签筛选：点击按 tag 显隐文章
    tagBtns.forEach(function(btn) {
      btn.addEventListener('click', function() {
        const selectedTag = btn.getAttribute('data-tag');

        tagBtns.forEach(function(b) {
          b.classList.remove('active');
        });
        btn.classList.add('active');

        postWrappers.forEach(function(wrapper) {
          const tagsAttr = wrapper.getAttribute('data-tags');
          const tags = tagsAttr ? JSON.parse(tagsAttr) : [];
          const shouldShow = selectedTag === '' || tags.includes(selectedTag);
          wrapper.style.display = shouldShow ? '' : 'none';
        });
      });
    });
  }

  initTagFilter();
  document.addEventListener('astro:page-load', initTagFilter);
</script>

<style>
  h2 {
    font-family: var(--font-family-sans);
    font-weight: 700;
    margin: 0 0 0.4em 0;
    font-size: 1.6em;
    transition: color 0.2s ease;
  }

  .post-item-footer {
    font-family: var(--font-family-sans);
    font-weight: 700;
  }

  .post-item-date {
    color: var(--text-secondary);
    text-align: left;
    text-transform: uppercase;
    font-weight: 400;
  }

  /* 文章列表：单列竖排 */
  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 20px;
  }

  .post-card {
    background-color: var(--background-body);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    border-color: var(--primary-color);
  }

  .post-card:hover h2 {
    color: var(--primary-color);
  }

  .post-card-link {
    display: block;
    padding: 1.6em 2em;
    color: inherit;
    text-decoration: none;
  }

  .post-card-link p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin: 0 0 0.8em 0;
    line-height: 1.6;
  }

  :global(.theme-dark) .post-card {
    border-color: rgba(255, 255, 255, 0.08);
  }

  .post-tags {
    margin: 0 0 0.8em 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .post-tag {
    padding: 3px 10px;
    background: var(--tag-bg);
    border-radius: 12px;
    font-size: 12px;
    color: var(--text-secondary);
  }

  .tags-filter {
    margin: 20px 0 40px 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: flex-start;
  }

  .filter-label {
    font-weight: 600;
    color: var(--text-main);
    flex-shrink: 0;
  }

  .tags-wrapper {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
  }

  .tags-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tags-inner.collapsed {
    max-height: 60px;
    overflow: hidden;
  }

  .tags-toggle {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border: none;
    background: var(--text-secondary);
    color: white;
    border-radius: 16px;
    cursor: pointer;
    font-size: 12px;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .tags-toggle:hover {
    background: var(--primary-color);
  }

  .tags-toggle .toggle-text {
    pointer-events: none;
  }

  .tags-toggle .toggle-arrow {
    pointer-events: none;
    font-size: 10px;
  }

  .tag-btn {
    padding: 6px 16px;
    border: 2px solid var(--primary-color);
    background: transparent;
    color: var(--primary-color);
    border-radius: 20px;
    cursor: pointer;
    font-size: 14px;
    transition: all 0.2s ease;
  }

  .tag-btn:hover {
    background: var(--primary-color);
    color: white;
  }

  .tag-btn.active {
    background: var(--primary-color);
    color: white;
  }
</style>
