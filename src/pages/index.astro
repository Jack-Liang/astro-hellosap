---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'SAP学习中心 - 免费SAP教程、学习资源与经验分享';
const description = 'SAP学习中心提供免费的SAP教程、学习资源和实战经验分享。涵盖SAP GUI安装配置、ABAP开发、HANA数据库等技术内容，适合SAP初学者和进阶开发者。';
const permalink = Astro.site.href;
---

<BaseLayout title={title} description={description} permalink={permalink}>
  <div class="home-container">
    <div class="home-copy">
           <h1 class="typing-title" data-phrases='["欢迎访问SAP学习中心","从零开始，掌握 SAP","ABAP 开发实战经验分享","让 SAP 学习更简单"]'>欢迎访问SAP学习中心</h1>
      <div style="margin: 1em 0;">
        <a href="/blog/" rel="noopener" style="display: inline-block; padding: 12px 24px; background-color: var(--primary-color); color: white; text-decoration: none; border-radius: 4px; font-weight: bold; transition: background-color 0.3s ease;">
          查看更多内容
        </a>
      </div>
    </div>

    <div class="hero-image-container">
      <picture>
        <source srcset="https://pexels.kiksoft.net/api/random?orientation=square" media="(min-width: 600px)">
        <img class="hero-image" alt="Illustration of person reading a book" src="/assets/home-illustration-small.png" width="550" height="466">
      </picture>
      <div class="hero-lottie" aria-hidden="true"></div>
      <!-- <p class="caption">
        Illustration by
        <a href="https://icons8.com/illustrations/author/5c07e68d82bcbc0092519bb6" target="_blank" rel="noopener">Icons 8</a>
        from
        <a href="https://icons8.com/illustrations" target="_blank" rel="noopener">Ouch!</a>
      </p> -->
    </div>
  </div>

  <div class="home-bottom-note" style="margin: 2em 0;">
    <p>
      <a href="/blog/change-sapgui-browser-control/" rel="noopener">
        <img src="/assets/E258_black.png" alt="Mouse cursor" class="mouse-icon" style="width: 20px; height: 20px; vertical-align: middle; margin-right: 4px;">
        若您在SAPGUI中访问本页面时显示异常，请修改设置。
      </a>
    </p>
  </div>

</BaseLayout>

<style>
  .home-container {
    align-items: center;
    display: flex;
    flex: 1;
    justify-content: center;
    margin: 2em 0;
    min-height: 400px;
  }

  .home-copy {
    flex: 1;
    padding: 0 1em;
  }

  .home-copy h1 {
    font-weight: 700;
    margin-bottom: 0.5em;
    line-height: 1.3;
  }

  /* 打字机标题：闪烁光标 */
  .typing-title {
    min-height: 1.3em;
  }

  .typing-title::after {
    content: '';
    display: inline-block;
    width: 0.08em;
    height: 0.9em;
    margin-left: 0.1em;
    background-color: var(--primary-color);
    vertical-align: text-bottom;
    animation: blink 0.8s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .home-copy p {
    font-size: 1.4em;
  }

  .hero-image-container {
    margin: 0 1em;
    text-align: center;
    position: relative;
    display: inline-block;
    width: 550px;
    max-width: 100%;
    aspect-ratio: 550 / 466;
    border-radius: 12px;
    overflow: hidden;
    background: #f5f6f7;
  }

  .hero-image-container.loaded {
    background: none;
  }

  /* 加载占位：猫咪 Lottie 动画，图片加载完淡出 */
  .hero-lottie {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(
      135deg,
      rgba(84, 142, 155, 0.12),
      rgba(110, 180, 195, 0.08),
      rgba(150, 205, 200, 0.1)
    );
    transition: opacity 0.6s ease;
  }

  .hero-lottie svg {
    width: 75%;
    height: auto;
    max-height: 90%;
  }

  .hero-image-container.loaded .hero-lottie {
    opacity: 0;
    pointer-events: none;
  }

  .hero-image-container picture {
    display: block;
  }

  :global(.theme-dark) .hero-image-container {
    background: #2a2a2a;
  }

  .caption {
    font-size: .8em;
    font-style: italic;
    text-align: left;
  }

  .hero-image {
    width: 100%;
    max-width: 550px;
    margin-bottom: 1em;
    opacity: 0;
    border-radius: 12px;
    transition: opacity 0.9s ease;
  }

  .hero-image-container.loaded .hero-image {
    opacity: 1;
  }

  @media (max-width: 1200px) {
    p {
      font-size: 1.2em;
    }

    .hero-image,
    .hero-image-container {
      max-width: 400px;
    }
  }

  @media (max-width: 800px) {
    .home-container {
      flex-direction: column;
    }

    .home-copy {
      flex: 0;
      padding-bottom: 2em;
      text-align: center;
    }
  }

  /* 兼容提示：默认隐藏，仅 IE（html.is-ie）显示 */
  .home-bottom-note {
    display: none;
  }

  :global(.is-ie) .home-bottom-note {
    display: block;
  }

  .home-bottom-note p {
    font-size: 1em;
    color: var(--text-secondary);
  }

  .home-bottom-note a {
    color: var(--primary-color);
    text-decoration: none;
  }

  .home-bottom-note a:hover {
    text-decoration: underline;
  }

  .mouse-icon {
    display: inline-block;
  }

  :global(.theme-dark) .mouse-icon {
    filter: invert(1);
  }
</style>

<script>
  import lottie from 'lottie-web/build/player/lottie_svg.js';

  let heroAnim = null;

  function initHeroImage() {
    const container = document.querySelector('.hero-image-container');
    const img = container && container.querySelector('.hero-image');
    const lottieEl = container && container.querySelector('.hero-lottie');
    if (!container || !img) return;

    // 加载并播放猫咪 Lottie 动画（仅未加载时）
    if (lottieEl && !lottieEl.dataset.loaded) {
      lottieEl.dataset.loaded = '1';
      fetch('/assets/cat-playing.json')
        .then((r) => r.json())
        .then((data) => {
          // 若图片已先于动画加载完成，则不必播放
          if (container.classList.contains('loaded')) return;
          heroAnim = lottie.loadAnimation({
            container: lottieEl,
            renderer: 'svg',
            loop: true,
            autoplay: true,
            animationData: data,
          });
        })
        .catch(() => {});
    }

    const markLoaded = () => {
      // 用 rAF 确保浏览器先记录初始态（opacity:0）再过渡，避免缓存图秒加载跳过动画
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          container.classList.add('loaded');
          // 图片就绪后停止并销毁 Lottie，释放资源
          if (heroAnim) {
            heroAnim.stop();
            heroAnim.destroy();
            heroAnim = null;
          }
        });
      });
    };

    // 兼容缓存命中（complete）与正常加载
    if (img.complete && img.naturalWidth > 0) {
      markLoaded();
    } else {
      img.addEventListener('load', markLoaded, { once: true });
      img.addEventListener('error', markLoaded, { once: true });
    }
  }

  // 打字机效果：多句话循环 —— 逐字打出 -> 停顿 -> 退格删除 -> 切换下一句
  let typingTimer;
  function initTypingTitle() {
    clearTimeout(typingTimer);
    const el = document.querySelector('.typing-title');
    if (!el) return;
    let phrases = [];
    try {
      phrases = JSON.parse(el.dataset.phrases || '[]');
    } catch (e) {}
    if (!phrases.length) {
      phrases = [el.textContent || ''];
    }

    let phraseIndex = 0;
    let i = 0;
    let deleting = false;
    el.textContent = '';

    const tick = () => {
      const text = phrases[phraseIndex];
      if (!deleting) {
        // 打字阶段
        i++;
        el.textContent = text.slice(0, i);
        if (i >= text.length) {
          // 当前句打完，停顿后开始删除
          deleting = true;
          typingTimer = setTimeout(tick, 1600);
          return;
        }
        typingTimer = setTimeout(tick, 160);
      } else {
        // 删除阶段
        i--;
        el.textContent = text.slice(0, i);
        if (i <= 0) {
          // 删完，切换到下一句
          deleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          typingTimer = setTimeout(tick, 400);
          return;
        }
        typingTimer = setTimeout(tick, 70);
      }
    };

    typingTimer = setTimeout(tick, 400);
  }

  initHeroImage();
  initTypingTitle();
  document.addEventListener('astro:page-load', () => {
    initHeroImage();
    initTypingTitle();
  });
</script>
